# BasicVatFlow

main: kit: flow: BasicVatFlow:
{
  entity: "vat",
  kind: "basic",
  name: "BasicVatFlow",
  step: [
    {
      i: {
        ref: "vat_ref01",
        srcdatavar: "vat_ref01_data",
        suffix: "_dt0"
      }

      m: {
        country: "country01",
        id: "vat01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vat_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVatFlow"
}