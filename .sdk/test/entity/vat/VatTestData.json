  "requests": {
    "GET /vat/{country}/{number}": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "validateVatNumber",
        "parameters": [
          {
            "description": "Two-letter ISO country code (e.g., DE, FR, NL, BE, IT, ES, PL, AT, SE, DK, or XI for Northern Ireland)",
            "in": "path",
            "name": "country",
            "required": true,
            "schema": {
              "example": "DE",
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            }
          },
          {
            "description": "VAT number without country code prefix",
            "in": "path",
            "name": "number",
            "required": true,
            "schema": {
              "example": "190119364",
              "type": "string"
            }
